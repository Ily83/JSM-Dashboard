# Jira Operations – Alert Center: backend configuration
#
# Copy this file to ".env" and fill in the Jira values to connect to Jira.
# Without them the application runs in demo mode with sample data.
# The .env file is read by the backend only and is ignored by git.

# ---- Jira Service Management Cloud (all three are needed for live mode) ----
# Site address, for example https://your-company.atlassian.net
JIRA_SITE_URL=
# Atlassian account that can see Operations alerts
JIRA_EMAIL=
# API token of that account: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Optional. Looked up from JIRA_SITE_URL when empty.
JIRA_CLOUD_ID=

# Optional extra restriction in Jira's alert search syntax, applied to every request.
# Example: teams: "Cloud Operations"
JIRA_ALERT_QUERY=

# Which alerts count as open and as closed, in Jira's alert search syntax.
# Change these only if acknowledged or snoozed alerts are missing on your site.
# JIRA_OPEN_QUERY=status: open
# JIRA_CLOSED_QUERY=NOT status: open

# Link used by "Open in Jira". {siteUrl} and {id} are replaced.
# JIRA_ALERT_URL_TEMPLATE={siteUrl}/jira/ops/alerts/{id}

# ---- Write actions (off by default: the application is read-only) ----
# Empty or false = read-only. true = all actions. Or a comma-separated list of:
# acknowledge, unacknowledge, close, snooze, assign, addResponder, escalate,
# addNote, priority, addTags, removeTags
# Every action is done as the account above. Try them on a test site first.
# JIRA_WRITE_ACTIONS=acknowledge,unacknowledge,addNote
JIRA_WRITE_ACTIONS=

# ---- How much is loaded ----
# Newest open alerts to load (the API cannot return more than 20,000)
# JIRA_MAX_ALERTS=2000
# Closed alerts: how many, and created within how many hours (0 = none)
# JIRA_MAX_CLOSED_ALERTS=500
# JIRA_CLOSED_LOOKBACK_HOURS=72

# ---- How often Jira is called ----
# Jira is queried at most once per this many seconds, however many browsers are open
# JIRA_CACHE_TTL_SECONDS=30
# A complete resynchronisation (open + closed + team names) runs this often
# JIRA_FULL_SYNC_MINUTES=15
# JIRA_REQUEST_TIMEOUT_MS=15000
# Per-alert requests for extra properties when the list does not include them:
# auto (open alerts only), always, never
# JIRA_ENRICH_DETAILS=auto
# JIRA_ENRICH_MAX_PER_SYNC=50

# Default auto-refresh of the browser, in seconds (each user can change it)
# REFRESH_INTERVAL_SECONDS=60

# ---- Which customer and service an alert belongs to ----
# Jira alerts have no customer or service field. They are read from tags with
# one of these prefixes ("customer:Contoso") and from extra properties with
# one of these keys (customer = "Contoso, Fabrikam"). Comma-separated lists.
# CUSTOMER_TAG_PREFIXES=customer:,customer=,cust:
# CUSTOMER_PROPERTY_KEYS=customer,customers
# SERVICE_TAG_PREFIXES=service:,service=
# SERVICE_PROPERTY_KEYS=service
# Use the alert's "entity" as service when nothing else is found
# SERVICE_FALLBACK_TO_ENTITY=true

# ---- Server ----
# PORT=8787
# HOST=127.0.0.1
# Extra host names allowed to reach the server (only needed behind a proxy)
# ALLOWED_HOSTS=
# LOG_LEVEL=info

# ---- Demo mode ----
# Force demo mode even when Jira values are set
# DEMO_MODE=true
# Add this many generated alerts to the sample set, to try large volumes
# DEMO_ALERT_COUNT=0
